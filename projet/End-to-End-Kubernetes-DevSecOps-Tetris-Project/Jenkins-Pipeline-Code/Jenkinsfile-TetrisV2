pipeline {
    agent any
    tools {
        nodejs 'nodejs'
    }
    environment  {
        SCANNER_HOME = tool 'sonar-scanner'
    }
    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout from Git') {
            steps {
                git branch: 'main', url: 'https://github.com/meliana-zerroug/devops_base.git'
            }
        }
        stage('Sonarqube Analysis') {
            steps {
                dir('projet/End-to-End-Kubernetes-DevSecOps-Tetris-Project/Tetris-V2') {
                    withSonarQubeEnv('sonar-server') {
                        sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=Tetris \
                        -Dsonar.projectKey=Tetris '''
                    }
                }
            }
        }
        stage('Quality Check') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }
        stage('Installing Dependencies') {
            steps {
                dir('projet/End-to-End-Kubernetes-DevSecOps-Tetris-Project/Tetris-V2') {
                    sh 'npm install'
                }
            }
        }
        stage('OWASP Dependency-Check Scan') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    dir('projet/End-to-End-Kubernetes-DevSecOps-Tetris-Project/Tetris-V2') {
                        withCredentials([string(credentialsId: 'nvdApiKey', variable: 'NVD_KEY')]) {
                            dependencyCheck additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit --noupdate', odcInstallation: 'DP-Check'
                            dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                        }
                    }
                }
            }
        }
        stage('Trivy File Scan') {
            steps {
                dir('projet/End-to-End-Kubernetes-DevSecOps-Tetris-Project/Tetris-V2') {
                    sh 'trivy fs . > trivyfs.txt'
                }
            }
        }
        stage("Docker Image Build") {
            steps {
                script {
                    dir('projet/End-to-End-Kubernetes-DevSecOps-Tetris-Project/Tetris-V2') {
                        withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                            sh 'docker system prune -f'
                            sh 'docker build -t tetrisv1 .'
                        }
                    }
                }
            }
        }
        stage("Docker Image Pushing") {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                        sh "docker tag tetrisv1 damienledey/tetrisv1:${BUILD_NUMBER}"
                        sh "docker push damienledey/tetrisv1:${BUILD_NUMBER}"
                    }
                }
            }
        }
        stage("TRIVY Image Scan") {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    sh "trivy image --timeout 15m damienledey/tetrisv1:${BUILD_NUMBER} > trivyimage.txt"
                }
            }
        }
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/meliana-zerroug/devops_base.git'
            }
        }
        stage('Update Deployment file') {
            environment {
                GIT_REPO_NAME = "devops_base"
                GIT_USER_NAME = "meliana-zerroug"
            }
            steps {
                dir('projet/End-to-End-Kubernetes-DevSecOps-Tetris-Project/Manifest-file') {
                    withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                        sh '''
                            git config user.email "meliana.zerroug@edu.esiee.fr"
                            git config user.name "meliana-zerroug"
                            BUILD_NUMBER=${BUILD_NUMBER}
                            echo $BUILD_NUMBER
                            imageTag=$(grep -oP '(?<=tetrisv1:)[^ ]+' deployment-service.yml)
                            echo $imageTag
                            sed -i "s/tetrisv1:${imageTag}/tetrisv1:${BUILD_NUMBER}/" deployment-service.yml
                            git add deployment-service.yml
                            git commit -m "Update deployment Image to version ${BUILD_NUMBER}"
                            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                        '''
                    }
                }
            }
        }
    }
}